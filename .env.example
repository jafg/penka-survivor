# Local development environment for penka-survivor.
#
# `pnpm demo` copies this file to `.env` when there isn't one and loads it before
# starting the stack. Everything in here is a DEV-ONLY value for a stack that
# listens on localhost: none of it is a secret, and none of it belongs in a
# deployed environment, where these two keys must be generated per environment
# and kept out of the repository.

# ── Required ───────────────────────────────────────────────────────────────

# Signs the player access/refresh tokens. Minimum 32 characters.
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# The only credential the back-office API accepts, sent as `x-admin-key` and
# compared in constant time. Minimum 32 characters.
ADMIN_API_KEY=dev-only-admin-key-change-me-0123456789ab

# ── Infrastructure (defaults match infra/docker-compose.yml) ───────────────

MONGO_URL=mongodb://127.0.0.1:27017
MONGO_DB=penka
REDIS_URL=redis://127.0.0.1:6379
RABBITMQ_URL=amqp://127.0.0.1:5672

# ── Optional knobs ─────────────────────────────────────────────────────────

# @penka/api: register/login attempts per minute per IP.
# RATE_LIMIT_MAX=10
# Set when the API runs behind a proxy, so the rate limiter sees the real IP.
# TRUST_PROXY=false

# @penka/workers: messages in flight (1 keeps the resolution queue serial),
# delivery attempts before a command is dead-lettered, and log verbosity.
# PREFETCH=1
# MAX_ATTEMPTS=5
# LOG_LEVEL=info

# The Vue apps reach the APIs through their Vite dev-server proxy, so these are
# only needed when an app is served from somewhere other than `pnpm dev`.
# VITE_API_BASE_URL=http://localhost:3000
# VITE_ADMIN_API_BASE_URL=http://localhost:3001
