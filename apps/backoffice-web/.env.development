# Empty on purpose: the admin client then builds relative URLs (`/admin/v1/...`),
# which the dev server proxies to `@penka/backoffice-api` on 3001. See
# `vite.config.ts`. Only `vite dev` reads this file — `pnpm build` runs in
# production mode and `pnpm test` in test mode, so neither is affected.
VITE_ADMIN_API_BASE_URL=

# The admin key the console sends as `ADMIN_KEY_HEADER`. MVP: the operator app
# holds a shared secret rather than a per-operator session.
#
# It MUST be byte-identical to `ADMIN_API_KEY` in the repo's root `.env`, which is
# what `@penka/backoffice-api` boots with and compares against — `timingSafeEqual`
# has no notion of "close enough", so a value that merely looks like the other one
# answers 401 to every operator request. It drifted once, and the whole console
# came up empty with the reason buried in the API log panel.
#
# Anything typed into the gate at runtime is kept in localStorage and wins over
# this value, which is what makes a local bundle usable against another stack
# without editing dotfiles.
VITE_ADMIN_API_KEY=dev-only-admin-key-change-me-0123456789ab

# The "Reiniciar datos de prueba" button. The admin API exposes no seed endpoint,
# so the control stays hidden unless an environment says otherwise — see
# `src/api/endpoints.ts`.
VITE_ADMIN_RESET_ENDPOINT=
