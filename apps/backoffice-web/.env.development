# Empty on purpose: the admin client then builds relative URLs (`/admin/v1/...`),
# which the dev server proxies to `@penka/backoffice-api` on 3001. See
# `vite.config.ts`. Only `vite dev` reads this file — `pnpm build` runs in
# production mode and `pnpm test` in test mode, so neither is affected.
VITE_ADMIN_API_BASE_URL=

# The admin key the console sends as `X-Admin-Key`. MVP: the operator app holds a
# shared secret rather than a per-operator session, so this matches `ADMIN_API_KEY`
# in the API's own env — which `loadConfig` refuses below 32 characters, hence the
# length. Anything typed into the console at runtime is kept in localStorage and
# wins over this value, which is what makes a local stack usable without editing
# dotfiles.
VITE_ADMIN_API_KEY=dev-only-admin-key-for-local-parity-0123456789

# The "Reiniciar datos de prueba" button. The admin API exposes no seed endpoint,
# so the control stays hidden unless an environment says otherwise — see
# `src/api/endpoints.ts`.
VITE_ADMIN_RESET_ENDPOINT=
