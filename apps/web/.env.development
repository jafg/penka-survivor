# Empty on purpose: the API client then builds relative URLs (`/api/v1/...`),
# which the dev server proxies to `@penka/api` on 3000. See `vite.config.ts`.
# Only `vite dev` reads this file — `pnpm build` runs in production mode and
# `pnpm test` in test mode, so neither is affected.
VITE_API_BASE_URL=
